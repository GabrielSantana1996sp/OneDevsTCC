{
  // Fastfetch config - OneDevs OS
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "/etc/fastfetch/onedevsos.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },

  "display": {
    "separator": "  →  ",
    "color": {
      "keys": "blue",
      "title": "blue"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": { "user": "bright_blue", "at": "white", "host": "white" }
    },
    "separator",
    { "type": "os",     "key": "  OS     " },
    { "type": "kernel", "key": "  Kernel " },
    { "type": "shell",  "key": "  Shell  " },
    { "type": "de",     "key": "  DE     " },
    { "type": "wm",     "key": "  WM     " },
    { "type": "cpu",    "key": "  CPU    " },
    { "type": "memory", "key": "  RAM    " },
    { "type": "disk",   "key": "  Disk   " },
    { "type": "uptime", "key": "  Uptime " },
    { "type": "datetime","key": "  Date   ", "format": "%d/%m/%Y %H:%M" },
    "separator",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 3
    }
  ]
}
